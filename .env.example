# Copy to .env and fill in. .env is gitignored and never committed.
# Missing keys are reported BY NAME at startup — see core/config.py::validate_env.

OPENAI_API_KEY=      # solver/judge: gpt-5.6-terra
GEMINI_API_KEY=      # solver/judge: gemini-3.7-flash
XAI_API_KEY=         # solver/judge: grok-4.6
HF_TOKEN=            # optional; MathArena/aime_2026 is public

# These names are also accepted and copied into the canonical ones at startup,
# with a note printed saying which was used:
#   OPENAI_API_KEY  <- OPENAI_TOKEN, OPENAI_KEY
#   GEMINI_API_KEY  <- GEMINI_TOKEN, GOOGLE_API_KEY, GEMINI_KEY
#   XAI_API_KEY     <- GROK_TOKEN, XAI_TOKEN, GROK_API_KEY
