# Copy to .env and fill in.  .env is gitignored and is never committed,
# never inlined into a page, and never written into a stored result.
#
#     cp .env.example .env
#
# Keys are read from the environment by the provider adapters only. Nothing in
# frontend code, in results/*.json, or in the generated HTML ever sees them.

OPENAI_API_KEY=       # solver + judge: gpt-5.6-terra
GEMINI_API_KEY=       # solver + judge: gemini-3.8-flash
XAI_API_KEY=          # solver + judge: grok-4.6

# GOOGLE_API_KEY is also accepted in place of GEMINI_API_KEY.
